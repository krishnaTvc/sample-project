# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files as they may contain sensitive content
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override files generated by terraform for CLI workspace support
.terraform.workspace

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore tfplan outputs
tfplan
